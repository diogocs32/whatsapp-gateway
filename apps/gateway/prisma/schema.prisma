// Prisma 7 — generator novo `prisma-client` (ESM por padrão; forçamos CJS p/ NestJS).
// O client é GERADO em src/generated/prisma (gitignored) e usado via driver adapter @prisma/adapter-pg.
// Rode `npm run prisma:generate -w apps/gateway` (ou migrate) antes de buildar.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String   @id
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

// Sessão do painel (refresh-token rotation). Cada LOGIN abre uma "família" (`sessionId`); cada uso do
// refresh ROTACIONA (revoga a linha atual, cria a próxima com o mesmo sessionId). Se um refresh já
// revogado for reapresentado (reuso = token roubado), revoga-se a família inteira e exige novo login
// (RFC 9700 §4.14 / OWASP). O texto do token NÃO é guardado — só `sha512(raw)` (mesmo padrão do WaApiKey).
model RefreshToken {
  id         String    @id // ULID via newId()
  userId     String
  tokenHash  String    @unique // SHA-512 (hex) do refresh token — o texto NÃO é persistido
  sessionId  String // "família": todos os tokens rotacionados a partir do mesmo login
  expiresAt  DateTime
  revokedAt  DateTime? // != null => rotacionado ou invalidado (logout/reuso)
  replacedBy String? // id do token que substituiu este (trilha de rotação)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId]) // revogar a família inteira
  @@index([expiresAt]) // purge de expirados
  @@map("refresh_tokens")
}

model WaLicense {
  id          String   @id @default("singleton")
  token       String
  installedAt DateTime @default(now())

  @@map("wa_licenses")
}

model WaBranding {
  id           String   @id @default("singleton")
  productName  String   @default("WhatsApp Gateway")
  logoUrl      String?
  primaryColor String   @default("#10b981")
  faviconUrl   String?
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("wa_branding")
}

model WaAuditLog {
  id         String   @id
  actor      String // "username (ROLE)" | "key:nome" | "login:username" | "anônimo"
  method     String
  path       String
  statusCode Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("wa_audit_logs")
}

model WaApiKey {
  id         String    @id
  name       String
  prefix     String // primeiros chars da chave (exibição no painel)
  hash       String    @unique // SHA-512 (hex) da chave completa — o texto da chave NÃO é guardado
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("wa_api_keys")
}

enum Engine {
  BAILEYS
  WWEBJS
}

enum SessionStatus {
  STOPPED
  STARTING
  SCAN_QR_CODE
  PAIRING_CODE
  WORKING
  FAILED
  DEGRADED
}

// G5 (guard-rail) — estado de SAÚDE da sessão (distinto do SessionStatus de conexão).
enum GuardrailState {
  ativa
  throttled
  quarentena
  aquecimento
  banida
  pausa_manual
}

// Instância/sessão de WhatsApp. `creds` guarda o AuthenticationCreds (BufferJSON-encoded);
// as Signal keys ficam em WaAuthKey (custom auth store — blueprint §8.4).
model WaSession {
  id               String        @id
  name             String        @unique
  engine           Engine        @default(BAILEYS)
  status           SessionStatus @default(STOPPED)
  meJid            String?
  mePushName       String?
  // E27 (P-086/P-089): último meJid conectado. O meJid zera quando o celular desconecta (401); este
  // fica — pré-preenche o número esperado do link de conexão e acha a sessão caída pelo número.
  lastMeJid        String?
  phoneNumber      String?
  autostart        Boolean       @default(true)
  creds            Json?
  metadata         Json?
  lastError        String?
  lastErrorDetails Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  authKeys     WaAuthKey[]
  messages     WaMessage[]
  contacts     WaContact[]
  campaigns    Campaign[]
  sendIntents  SendIntent[]
  triage       ConversationTriage[]
  reactions    MessageReaction[]
  events       WaSessionEvent[]
  metrics      SessionMetric[]
  guardrail    SessionGuardrail?
  config       SessionConfig?
  connectLinks ConnectLink[]

  @@map("wa_sessions")
}

// E27/P-086 (D-037) — link público temporário para outra pessoa conectar a sessão lendo o QR de
// outra tela. O texto do token NÃO é guardado — só sha512(raw), como refresh_tokens/api_keys. Um
// link ativo por sessão (criar outro revoga o anterior). `consumedAt` só é gravado quando a sessão
// fica WORKING com o número esperado. Dono: módulo sessions. Datas com fuso (R13).
model ConnectLink {
  id            String    @id
  sessionId     String
  tokenHash     String    @unique
  createdBy     String
  expectedPhone String? // só dígitos; null = qualquer número
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String? // MANUAL | REPLACED | SESSION_STOPPED | WRONG_NUMBER
  consumedAt    DateTime? @db.Timestamptz(3)
  newQrCount    Int       @default(0)
  lastNewQrAt   DateTime? @db.Timestamptz(3)
  lastSeenAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("wa_connect_links")
}

// G8 — config de ENVIO por sessão, editável em runtime (PATCH /sessions/:id/config). `cap_atual`
// NÃO é persistido: é derivado de capBase + warmupCurve + estado guard-rail (ver SessionConfigService).
model SessionConfig {
  id               String   @id
  sessionId        String   @unique
  capBase          Int      @default(20) // teto diário de cold-sends quando ativa
  warmupCurve      Int[]    @default([5, 10, 20]) // trickle de cold/dia durante aquecimento
  regiaoDdd        String? // DDD p/ geo-match do proxy sticky (refino)
  modo             String   @default("cold_ok") // cold_ok | inbound_only | manual_first
  janelaInicio     Int      @default(8) // hora local de início do envio (0-23)
  janelaFim        Int      @default(20) // hora local de fim
  timezone         String   @default("America/Sao_Paulo")
  device           Json? // fingerprint estável/pinado
  wwebjsWebVersion String? // override do WA Web por sessão; null usa WWEBJS_WEB_VERSION global
  updatedAt        DateTime @default(now()) @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_config")
}

// G5 (guard-rail) — estado por sessão da máquina de saúde. Em modo OBSERVAÇÃO
// (GUARDRAIL_ENFORCE=false) o estado é calculado/registrado mas NÃO bloqueia envios; o hard-gate
// HTTP 423 do G5 só atua com enforce=true; a restrição nativa P-048 atua sempre.
// `eventTs` dá idempotência das transições (C10).
model SessionGuardrail {
  id                String         @id
  sessionId         String         @unique
  state             GuardrailState @default(ativa)
  reason            String? // motivo da última transição
  quarentenaDesde   DateTime?
  cooldownAte       DateTime?
  ultimoSinal       String? // último sinal duro (463, close não-recuperável, restrição)
  restrictionUntil  DateTime? // P-048: trava temporária de TODO envio; expira sem override manual
  restrictionSignal String? // sinal que fixou o prazo (463, reachoutTimeLock, message-capping)
  restrictionSource String? // timeEnforcementEnds, cycle_end_timestamp ou temporary
  restrictionType   String? // enforcementType informado pelo WhatsApp, quando houver
  eventTs           DateTime       @default(now()) // C10: só aplica transição se eventTs < novo evento
  updatedAt         DateTime       @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_guardrail")
}

// G6 (C4) — dead-letter de webhooks: quando a entrega ESGOTA os retries (ex.: n8n fora do ar), o
// evento é preservado aqui em vez de sumir. A reconciliação (POST /webhooks/dead-letters/redeliver)
// reenfileira usando a config ATUAL do webhook quando o n8n volta. Sem secret/headers persistidos
// (segurança — a reentrega assina com o secret atual do webhook).
model WebhookDeadLetter {
  id            String    @id
  webhookId     String
  url           String // url no momento da falha (informativo)
  body          Json
  error         String?
  attempts      Int       @default(0)
  failedAt      DateTime  @default(now())
  redeliveredAt DateTime?

  @@index([redeliveredAt, failedAt])
  @@map("webhook_dead_letters")
}

// G7 — config GLOBAL do guard-rail, tunável em runtime (PATCH /guardrail/config) SEM redeploy.
// Singleton (id="singleton"). Campo null = usa o default do env (GUARDRAIL_*).
model GuardrailConfig {
  id              String   @id @default("singleton")
  nmin            Int?
  throttleMult    Float?
  quarantineMult  Float?
  targetReplyRate Float?
  cooldownHours   Int?
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("guardrail_config")
}

// G4 (guard-rail/reply-rate): snapshot por sessão+janela. `replyRate` = responded/coldMature,
// onde coldMature EXCLUI cold-sends < 72h (correção C2 — senão número novo cai em falso-positivo).
// Lido pelo G5 (guard-rail) e pelos dashboards. Atualizado por upsert (1 snapshot atual por janela).
model SessionMetric {
  id           String   @id
  sessionId    String
  windowDays   Int // 7 = operacional, 30 = referência
  coldTotal    Int      @default(0) // cold-sends na janela
  coldMature   Int      @default(0) // cold-sends já maduros (>72h) = denominador do replyRate (C2)
  responded    Int      @default(0) // cold maduros respondidos (inbound em até 72h)
  replyRate    Float    @default(0) // responded / coldMature (0..1); 0 se coldMature=0
  sample       Int      @default(0) // = coldMature (amostra do veredito)
  reliable     Boolean  @default(false) // sample >= Nmin (20)
  deliveryRate Float    @default(0) // delivered|read / coldTotal (0..1)
  readRate     Float    @default(0) // read / coldTotal (0..1)
  scoreSaude   Float    @default(0) // 0..100 (ponderação tunável de reply/read/delivery)
  computedAt   DateTime @default(now())

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, windowDays])
  @@index([sessionId, computedAt])
  @@map("session_metrics")
}

// Timeline de eventos da sessão (F7 — Observability): conexões, reconexões, troca de proxy, erros.
model WaSessionEvent {
  id        String   @id
  sessionId String
  type      String   @default("status") // status | proxy | error
  status    String? // valor de SessionStatus quando type=status
  detail    String? // texto livre (erro, proxy, etc.)
  createdAt DateTime @default(now())

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  // Retenção (item 13): purge por idade varre createdAt sem sessionId — precisa do índice próprio.
  @@index([createdAt])
  @@map("wa_session_events")
}

// Mensagens (F2) — enviadas e recebidas. `raw` guarda o conteúdo proto para histórico/depuração.
model WaMessage {
  id              String    @id
  sessionId       String
  keyId           String
  chatJid         String
  senderJid       String?
  fromMe          Boolean   @default(false)
  // G1 (guard-rail/reply-rate): `isCold` marca o 1º contato permissionado; `idempotencyKey`
  // dá dedup forte de envio (retry do n8n não duplica). Só fazem sentido em outbound (fromMe).
  isCold          Boolean   @default(false)
  idempotencyKey  String?
  // G2: origem de um fromMe — "api" (nossa API) | "phone" (celular/outro device). null em inbound.
  source          String?
  type            String    @default("text")
  text            String?
  status          String?
  raw             Json?
  // Mídia (F4): em mídia, `type` = image|video|audio|document|sticker; mediaKey = objeto no S3.
  mediaType       String?
  mimetype        String?
  fileName        String?
  mediaKey        String?
  fileSize        Int?
  // P-066 (E22): selo "Encaminhada" do WhatsApp — `contextInfo.isForwarded`/`forwardingScore` (Baileys)
  // ou `msg.isForwarded`/`forwardingScore` (wwebjs). forwardingScore = quantas vezes a mensagem já
  // foi encaminhada (null quando a mensagem não é encaminhada ou a engine não informa).
  isForwarded     Boolean   @default(false)
  forwardingScore Int?
  // P-068 (E24): marcas de mensagem APAGADA para todos / EDITADA (Baileys `messages.update` REVOKE
  // e MESSAGE_EDIT). Só o encaminhar lê (recusa: com a original guardada em `raw` ele mandaria o
  // conteúdo apagado ou a versão velha). A exibição no painel fica para a P-069.
  revokedAt       DateTime?
  editedAt        DateTime?
  timestamp       DateTime
  createdAt       DateTime  @default(now())

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Dedup idempotente por sessão. No Postgres o default é NULLS DISTINCT, então só restringe
  // quando idempotencyKey ≠ null (inbound e envios sem key continuam livres). Se o volume crescer,
  // trocar por índice parcial (WHERE idempotencyKey IS NOT NULL) via migration custom.
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, chatJid, timestamp])
  @@index([sessionId, keyId])
  // Retenção (item 13): purge/strip do raw por idade varre createdAt — precisa do índice próprio.
  @@index([createdAt])
  @@map("wa_messages")
}

// P-066 (E22) — reações às mensagens, UMA linha por (sessão, mensagem-alvo, quem reagiu): no
// WhatsApp cada pessoa tem no máximo uma reação por mensagem (trocar o emoji substitui). A reação
// NÃO é mensagem: não entra em wa_messages (antes virava `type:'other'` com texto vazio → "…" no
// painel, 🔴 na triagem e handoff falso). `senderKey` é a identidade estável de quem reagiu, usada no
// unique: 'me' = nós (API ou celular) · 'peer' = o contato numa conversa 1:1 (imune a LID×telefone)
// · jid normalizado do participante em grupo. Reação removida vira `emoji = ''` (lápide): guarda o
// horário para uma reação ANTIGA reprocessada fora de ordem não ressuscitar; as leituras filtram
// `emoji <> ''`. O reply-rate (G4) conta reação do contato como resposta (D-028).
model MessageReaction {
  id          String   @id
  sessionId   String
  chatJid     String // conversa, normalizada como em wa_messages quando o LID é conhecido
  targetKeyId String // keyId da mensagem que recebeu a reação
  senderKey   String // 'me' | 'peer' | jid do participante (grupo)
  senderJid   String? // quem reagiu, como a engine informou (best-effort)
  fromMe      Boolean  @default(false)
  emoji       String // '' = reação removida (lápide)
  timestamp   DateTime // quando a reação foi feita (relógio de quem reagiu)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, targetKeyId, senderKey])
  // reply-rate: reação do contato no MESMO chat dentro da janela de 72h.
  @@index([sessionId, chatJid, timestamp])
  // Retenção (RETENTION_MESSAGES_DAYS): purge por idade varre createdAt.
  @@index([createdAt])
  @@map("wa_message_reactions")
}

// ABE-03 (auditoria 09/2026) — intenção de envio DURÁVEL, reservada ANTES do transporte.
// O unique (sessionId, idempotencyKey) em wa_messages só protege DEPOIS do efeito; aqui a reserva
// atômica garante que duas chamadas concorrentes com a mesma key disparem UM envio, que a key
// reutilizada com outro payload seja rejeitada (fingerprint) e que falha/queda vire estado
// consultável (pending/sent/failed) em vez de retry cego.
model SendIntent {
  id             String   @id
  sessionId      String
  idempotencyKey String
  fingerprint    String // sha256 dos parâmetros relevantes (destino + conteúdo)
  status         String   @default("pending") // pending | sent | failed
  keyId          String?
  chatJid        String?
  error          String?
  attempts       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  // Retenção (RETENTION_INTENTS_DAYS): purge por idade varre createdAt.
  @@index([createdAt])
  @@map("wa_send_intents")
}

// Triagem humana da caixa única (página Atendimento) — SÓ o estado AMARELO ("não preciso
// responder") mora aqui. Vermelho ("precisa responder") e verde ("respondido") são DERIVADOS de
// wa_messages e não têm registro: a última mensagem da conversa decide. O amarelo é ancorado na
// mensagem de ENTRADA que estava por último quando o dono clicou (`markedKeyId`) — chegando
// entrada NOVA a âncora deixa de valer e a conversa volta a vermelho sozinha, sem limpar nada.
// Uma linha por conversa (sessão + chat); não guarda autor (decisão do dono 15/09).
model ConversationTriage {
  id              String   @id
  sessionId       String
  chatJid         String
  // keyId da última mensagem de entrada no instante da marcação. Null = marca sem âncora
  // (conversa sem entrada conhecida) — nesse caso vale o markedTimestamp.
  markedKeyId     String?
  markedTimestamp DateTime // timestamp da mensagem de entrada ancorada (ou do clique, se não houver)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chatJid])
  @@map("wa_conversation_triage")
}

// Diretório de contatos (F5+) — mapeia LID↔telefone e acumula metadados de TODAS as fontes
// (mensagens, onWhatsApp, participantes de grupo, contacts.upsert/update). `waId` é o id
// canônico do Baileys (jid OU lid). `data` (jsonb) é bucket livre p/ automações/"tratamento".
model WaContact {
  id           String   @id
  sessionId    String
  waId         String // id canônico do Baileys (jid ou lid)
  jid          String? // telefone @s.whatsapp.net (quando conhecido)
  lid          String? // identificador anônimo @lid
  phone        String? // só dígitos
  pushName     String? // nome que o contato definiu (notify)
  name         String? // nome salvo na agenda
  verifiedName String? // nome verificado (business)
  imgUrl       String?
  status       String?
  source       String? // message | onwhatsapp | group | contacts-sync
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, waId])
  @@index([sessionId, lid])
  @@index([sessionId, jid])
  // namesFor (hot path de leads/grupos) busca por OR em waId/lid/jid/phone — phone era a única
  // chave SEM índice, impedindo o BitmapOr completo do planner (a busca de contatos por telefone
  // no painel também usa). Índice aditivo (migration indice_wa_contacts_phone).
  @@index([sessionId, phone])
  @@map("wa_contacts")
}

// Webhook (F2b): entrega de eventos a sistemas externos. sessionId null = global.
model Webhook {
  id          String   @id
  sessionId   String?
  url         String
  events      String[]
  secret      String?
  headers     Json?
  enabled     Boolean  @default(true)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("webhooks")
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS4
  SOCKS5
}

enum ProxySource {
  MANUAL
  WEBSHARE
}

enum ProxyStatus {
  UNTESTED
  ALIVE
  DEAD
}

enum ProxyMode {
  NONE
  SINGLE
  RANGE
  GLOBAL_ROUND_ROBIN
}

enum ProxyStrategy {
  STICKY
  ROUND_ROBIN
  LEAST_LATENCY
  RANDOM
}

// Pool de proxies (§7.2). `position` é o ID 1..N estável usado nas faixas por instância.
model Proxy {
  id           String        @id
  position     Int           @unique
  label        String?
  protocol     ProxyProtocol @default(SOCKS5)
  host         String
  port         Int
  username     String?
  password     String?
  source       ProxySource   @default(MANUAL)
  webshareId   String?       @unique
  country      String?
  exitIp       String?
  latencyMs    Int?
  status       ProxyStatus   @default(UNTESTED)
  lastTestedAt DateTime?
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([enabled, status])
  @@map("proxies")
}

// Atribuição de proxy por sessão (§7.3): modo + faixa de posições + estratégia.
model SessionProxyAssignment {
  sessionId      String        @id
  mode           ProxyMode     @default(NONE)
  rangeStart     Int?
  rangeEnd       Int?
  strategy       ProxyStrategy @default(STICKY)
  currentProxyId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("session_proxy_assignments")
}

// Signal key store (pre-keys, sender-keys, app-state-sync-keys...). 1 linha por (sessão, tipo, id).
model WaAuthKey {
  sessionId String
  type      String
  keyId     String
  data      Json

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, type, keyId])
  @@index([sessionId, type])
  @@map("wa_auth_keys")
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  DONE
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Campanhas em massa (F6) com anti-ban: espaçamento aleatório, "digitando", cap diário, agendamento.
model Campaign {
  id            String         @id
  sessionId     String
  name          String
  messageType   String         @default("text") // text | image | video | audio | document
  text          String?
  mediaUrl      String? // mídia por URL (o worker baixa e envia)
  mediaMime     String?
  fileName      String?
  minDelaySec   Int            @default(8) // anti-ban: espaçamento mínimo entre envios
  maxDelaySec   Int            @default(25) // espaçamento máximo
  dailyCap      Int? // limite diário de envios (opcional)
  typingPreview Boolean        @default(true) // humanização: mostra "digitando" antes
  // ABE-02 (auditoria 09/2026): campanha de 1º contato passa pelo MESMO gate do endpoint de
  // mensagens (cold) e seus envios contam como cold no reply-rate. Explícito e auditável.
  firstContact  Boolean        @default(true)
  status        CampaignStatus @default(DRAFT)
  total         Int            @default(0)
  sentCount     Int            @default(0)
  failedCount   Int            @default(0)
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  session    WaSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([sessionId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String                  @id
  campaignId String
  to         String // número (E.164 sem +) ou JID
  status     CampaignRecipientStatus @default(PENDING)
  keyId      String?
  error      String?
  sentAt     DateTime?
  // ABE-04: reserva atômica do destinatário (1 worker por vez) + tentativas (teto para
  // resultado indeterminado após worker morto no meio do envio).
  reservedAt DateTime?
  attempts   Int                     @default(0)
  createdAt  DateTime                @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("campaign_recipients")
}
