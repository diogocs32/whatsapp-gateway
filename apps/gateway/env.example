# =============================================================================
# EXEMPLO de configuração de DESENVOLVIMENTO LOCAL do gateway.
#
# Uso:   cp env.example .env    (depois ajuste o que quiser)
# Os valores abaixo já batem com o docker-compose.yml local (npm run infra:up):
#   Postgres :5436  ·  Redis :6382  ·  MinIO :9000 (console :9001)
# O Prisma CLI lê este .env (rode `prisma generate` / `prisma migrate` com ele presente).
#
# Booleans (semântica do D-007 — NÃO é coerce.boolean): liga = true/1/yes/on ·
# desliga = false/0/no/off (case-insensitive) · ausente/vazio = default ·
# valor inválido DERRUBA O BOOT com o nome da variável (fail-fast proposital).
#
# NUNCA versione o .env preenchido (já está no .gitignore). Exemplo de PRODUÇÃO
# (Dokploy/R2, com guia de setup): env.production.example.
# =============================================================================

NODE_ENV=development
PORT=3000

# -- PostgreSQL (docker-compose local) — OBRIGATÓRIO ---------------------------
# URL única (tem prioridade) OU as partes DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=postgresql://gateway:gateway@localhost:5436/gateway?schema=public
# Alternativa em partes (evita URL-encode de senha com caractere especial):
# DB_HOST=localhost
# DB_PORT=5436
# DB_USER=gateway
# DB_PASSWORD=gateway
# DB_NAME=gateway
# DB_SSL=false        # só ligue se o Postgres EXIGIR SSL (não é o caso do compose local)

# -- Redis (docker-compose local) — OBRIGATÓRIO --------------------------------
# URL única (tem prioridade) OU as partes REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
REDIS_URL=redis://localhost:6382
# Alternativa em partes:
# REDIS_HOST=localhost
# REDIS_PORT=6382
# REDIS_USERNAME=default    # padrão do Redis 6+
# REDIS_PASSWORD=           # o compose local não usa senha
# REDIS_DB=0

# -- JWT do painel — OBRIGATÓRIO (mínimo 16 chars; troque em produção) ----------
JWT_SECRET=dev-secret-troque-isto-por-32-chars-ou-mais
JWT_EXPIRES_IN=43200        # validade do token em segundos (12h)

# -- Admin inicial do painel (criado no 1º boot se não houver usuários) ---------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123 # OBRIGATÓRIO (mínimo 6 chars)

# -- API pública (header X-Api-Key) para integrações (a partir da F2) -----------
# Mínimo 8 chars. Sem definir, as rotas /api que exigem X-Api-Key ficam indisponíveis.
# API_KEY=defina-uma-chave-forte-para-dev

# -- Assentos / sessões no MODO COMUNIDADE (sem licença) — a licença sobrepõe ---
# MAX_SEATS=1
# MAX_SESSIONS=1
# LICENSE_KEY=            # licença Ed25519 (CZL1...) via bootstrap; o normal é instalar pelo painel

# -- CORS: origem(ns) do dashboard (separe por vírgula) ------------------------
CORS_ORIGIN=http://localhost:5173

# -- Log da engine WhatsApp (Baileys): fatal|error|warn|info|debug|trace|silent -
WA_LOG_LEVEL=error

# -- Proxies (F3) — opcional ---------------------------------------------------
# WEBSHARE_API_KEY=seu-token-webshare      # habilita o sync automático do pool
PROXY_TEST_ECHO_URL=https://api.ipify.org?format=json
# Re-teste periódico do pool (revive DEAD que voltou, derruba quem morreu). 0 desliga.
# PROXY_RETEST_INTERVAL_MIN=30
# Anti-flag: se ligado, a engine RECUSA conectar sessão sem proxy vivo (em vez de vazar o IP do
# servidor/datacenter ao WhatsApp). Ligue só DEPOIS de atribuir proxy a todas as sessões.
# WA_REQUIRE_PROXY=false                    # true/1/yes/on liga · false/0/no/off desliga

# -- Storage de mídia (S3-compatível) ------------------------------------------
# Os defaults do código JÁ apontam para o MinIO do docker-compose local — não
# precisa definir nada em dev. Descomente só se quiser sobrescrever.
# SEM um storage acessível, mídia recebida não é armazenada (webhook sem mediaUrl,
# GET /messages/{id}/media responde 404).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=wa-media
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio12345
# S3_FORCE_PATH_STYLE=true   # true p/ MinIO/R2/B2 · false p/ AWS S3
# MEDIA_URL_TTL=3600          # validade do link pré-assinado (s)
# MEDIA_MAX_BYTES=67108864    # 64 MB (limite por arquivo)

# -- Engine WWEBJS (whatsapp-web.js) — só se for usar esse motor ----------------
# Precisa de Chrome/Chromium instalado. Persista o WWEBJS_DATA_PATH p/ não re-parear.
# WWEBJS_CHROME_PATH=/usr/bin/google-chrome-stable
# WWEBJS_DATA_PATH=auth/wwebjs
# Versão do WhatsApp Web: default = 2.3000.1045101284-alpha (validada; sai do catálogo em 13/10).
# Candidata 2.3000.1046934385-alpha até 07/11: testar com chip antes de promover.
# 'auto' = mais nova (risco LID-only) · 'live' = não fixa.
# Override por sessão: PATCH /api/sessions/{id}/config {"wwebjsWebVersion":"..."}; só no próximo start.
# WWEBJS_WEB_VERSION=2.3000.1045101284-alpha
# UA: default = realista e ESTÁVEL POR SESSÃO (anti-flag); a env força um UA global único.
# WWEBJS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36

# -- Guard-rail anti-ban (G1–G8) — onda M2 -------------------------------------
# Default = modo OBSERVAÇÃO: mede reply-rate e registra o que FARIA, mas NÃO bloqueia.
# Deixe TUDO deste bloco SEM definir para observar. Ligar o bloqueio é o fim da M2.
# GUARDRAIL_ENFORCE=false            # true/1/yes/on liga o bloqueio · false/0/no/off desliga
# Limiares (defaults abaixo; PATCH /api/guardrail/config ajusta em runtime, com prioridade):
# GUARDRAIL_NMIN=20                  # amostra mínima de cold-sends maduros (>72h) p/ veredito
# GUARDRAIL_THROTTLE_MULT=0.75       # reply < mediana×0.75 → throttled
# GUARDRAIL_QUARANTINE_MULT=0.6      # reply < mediana×0.6 → quarentena (cold → HTTP 423)
# GUARDRAIL_TARGET_REPLY_RATE=0.35   # baseline de fallback enquanto a frota for pequena
# GUARDRAIL_COOLDOWN_HOURS=48        # cooldown base da quarentena
# Guia da janela de observação e do flip: docs/how-to/observacao-guardrail-m2.md

# -- Segurança / observabilidade — opcionais -----------------------------------
# Nível dos logs estruturados da app (JSON). Default: dev=debug, prod=info, test=silent.
# LOG_LEVEL=debug
# Token do scrape Prometheus (GET /metrics?token=... ou Authorization: Bearer).
# SEM esta env o /metrics fica FECHADO (expõe dados operacionais).
# METRICS_TOKEN=defina-um-token-para-o-metrics
# Rate limit por IP/minuto (login tem teto próprio de 10/min). 0 desliga.
# RATE_LIMIT_MAX=600
# Fan-out de eventos entre réplicas via Redis pub/sub (SSE/webhooks veem todas). 'off' desliga.
# EVENT_FANOUT=on

# -- Retenção de dados (0 desliga; varredura a cada RETENTION_SWEEP_HOURS) -------
# RETENTION_SWEEP_HOURS=6
# RETENTION_MESSAGE_RAW_DAYS=7       # zera o proto `raw` (pesado) das mensagens antigas
# RETENTION_MESSAGES_DAYS=90         # remove mensagens (e as reações — E22) mais velhas que isso
# RETENTION_EVENTS_DAYS=30           # timeline de eventos de sessão
# RETENTION_AUDIT_DAYS=180           # audit log
# RETENTION_INTENTS_DAYS=90          # chaves de idempotência (wa_send_intents) — ABE-03

# -- Auditoria 09/2026 — segurança e ciclo de vida (defaults preservam o comportamento) ----
# Egress/SSRF (ABE-06): webhook, mediaUrl de campanha e /messages/media-url NÃO podem apontar
# para rede privada/loopback/metadata. n8n interno legítimo? liste o host aqui.
# EGRESS_ALLOW_HOSTS=n8n,10.0.0.5
# EGRESS_ALLOW_PRIVATE=false         # true desliga o bloqueio inteiro — só para dev
# Teto do client.initialize() do wwebjs em ms (WA-08/P-025). Default 240000 (4 min).
# WWEBJS_INIT_TIMEOUT_MS=240000
# TLS verificado no Postgres (ABE-15): CA em PEM (aceita "\n" escapado). Sem CA, DB_SSL cifra
# sem verificar (comportamento anterior) salvo DB_SSL_REJECT_UNAUTHORIZED=true.
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=false
# Redis com TLS (ABE-15): rediss:// na REDIS_URL, ou REDIS_TLS=true com as partes.
# REDIS_TLS=false
# Custo do scrypt de senha como log2(N), 12..20 (ABE-11). 14 = default do Node; subir só após
# medir no hardware real. Hash guarda o custo; re-hash transparente no login.
# PASSWORD_SCRYPT_LOG2N=14
