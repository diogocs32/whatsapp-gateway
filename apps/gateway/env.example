# Copie para apps/gateway/.env e ajuste os valores.  (cp env.example .env)
NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose local). O Prisma CLI lê este arquivo.
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway?schema=public

# Redis (docker-compose local)
REDIS_URL=redis://localhost:6379

# JWT do painel — TROQUE em produção (mínimo 16 chars)
JWT_SECRET=dev-secret-troque-isto-por-32-chars-ou-mais
JWT_EXPIRES_IN=43200

# Admin inicial do painel (criado no primeiro boot se não houver usuários)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Origem(ns) permitida(s) para CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# Chave da API pública (X-Api-Key) — usada a partir da F2
# API_KEY=defina-uma-chave-forte

# Nível de log da engine WhatsApp (Baileys): fatal|error|warn|info|debug|trace|silent
WA_LOG_LEVEL=error

# Proxies (F3)
# WEBSHARE_API_KEY=seu-token-webshare   # para sync automático do pool
PROXY_TEST_ECHO_URL=https://api.ipify.org?format=json
