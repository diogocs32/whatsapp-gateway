# =============================================================================
# EXEMPLO de configuração de PRODUÇÃO do gateway.
#
# Como usar:
#   - No Dokploy (recomendado): cole estas variáveis no painel do app em
#     "Environment" — NÃO suba arquivo .env com segredos para o servidor/git.
#   - Sem Dokploy: copie para `.env` no host e preencha os valores reais.
#
# Regras: troque TODO valor "TROQUE_*". Gere segredos fortes:
#     openssl rand -hex 32        (JWT_SECRET)
#     openssl rand -hex 24        (API_KEY)
# NUNCA versione o arquivo preenchido (já há .env* no .gitignore).
# =============================================================================

NODE_ENV=production
PORT=3000

# -- PostgreSQL (PARTES — sem URL-encode de senha). Host = NOME DO SERVIÇO no Dokploy. ---------
DB_HOST=postgres
DB_PORT=5432
DB_USER=gateway
DB_PASSWORD=TROQUE_SENHA_DB
DB_NAME=gateway
# DB_SSL — só defina se o Postgres EXIGIR SSL (ex.: gerenciado externo). Caso do Dokploy: não.
# Booleans deste arquivo: true/1/yes/on = liga · false/0/no/off = desliga · ausente = default ·
# valor inválido DERRUBA O BOOT com o nome da variável (proposital — fail-fast).
# DB_SSL=true
# Alternativa (tem prioridade se setada): DATABASE_URL=postgresql://user:pass@host:5432/db

# -- Redis (PARTES — resolve NOAUTH/encode). Host = NOME DO SERVIÇO no Dokploy. ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TROQUE_SENHA_REDIS
# REDIS_USERNAME=default     # padrão do Redis 6+; mude só se usar outro user ACL
# Alternativa (tem prioridade se setada): REDIS_URL=redis://default:senha@host:6379

# -- Sessão do painel (refresh-token rotation) --------------------------------
# Mínimo 16 chars; use 32+. Gere com: openssl rand -hex 32. Assina o ACCESS token (JWT).
JWT_SECRET=TROQUE_use_openssl_rand_hex_32
# Access token curto: o refresh renova sozinho (silent refresh), então o usuário não sente.
# Menor = mais seguro (janela de token vazado). Padrão 900s (15 min). Opcional.
JWT_ACCESS_TTL=900
# Refresh token (opaco, rotacionado): quanto tempo o usuário fica logado sem redigitar senha.
# Padrão 2592000s (30 dias). Opcional.
JWT_REFRESH_TTL=2592000
# DEPRECATED: era a vida do antigo JWT único de 12h. Não é mais usado (ficou access+refresh).
# Pode REMOVER do Dokploy; se ficar, é ignorado. Mantido aqui só para referência histórica.
#JWT_EXPIRES_IN=43200

# -- API pública (header X-Api-Key) para integrações --------------------------
# Mínimo 8 chars. Gere com: openssl rand -hex 24
API_KEY=TROQUE_chave_api_forte

# -- Admin inicial do painel (criado no 1º boot, se não houver usuários) -------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=TROQUE_senha_admin_forte    # mínimo 6; use 16+

# -- CORS: domínio(s) do dashboard em produção (https), separados por vírgula --
# Inclua todos os domínios que acessam a API pelo navegador (dashboard, landing). DEVE bater EXATO
# com o Origin do painel (senão o cookie de sessão não é enviado). Em prod hoje = conexozenvo.com
# (raiz), NÃO um subdomínio. Confirme no navegador antes de mudar.
CORS_ORIGIN=https://conexozenvo.com

# -- Nível de log da engine: fatal|error|warn|info|debug|trace|silent ---------
WA_LOG_LEVEL=warn

# -- Proxies (F3) — opcional --------------------------------------------------
# WEBSHARE_API_KEY=seu-token-webshare      # habilita o sync automático do pool
PROXY_TEST_ECHO_URL=https://api.ipify.org?format=json

# -- Storage de mídia (S3-compatível) — OBRIGATÓRIO p/ mídia recebida ---------
# SEM estas envs o gateway NÃO armazena voz/imagem/PDF recebidos: a mensagem chega
# só com metadados, o webhook vai sem mediaUrl e o download (GET /messages/{id}/media,
# contrato CP-149) responde 404. Sintoma no boot: "Não foi possível garantir o bucket".
#
# ── Setup Cloudflare R2 (recomendado — ~5 min, egress grátis) ────────────────
# 1) dash.cloudflare.com → R2 → "Create bucket" → nome: wa-media (privado, default).
# 2) R2 → "Manage API Tokens" → "Create API Token":
#      Permissão: Object Read & Write   |   Escopo: Apply to specific buckets → wa-media
#    → copie o "Access Key ID" e o "Secret Access Key" (só aparecem UMA vez).
# 3) O ACCOUNT_ID aparece na própria página do R2 (e na URL do dashboard).
# 4) RECOMENDADO: no bucket → Settings → "Object lifecycle rules" → deletar objetos
#    com mais de 90 dias (espelha a retenção do banco — RETENTION_MESSAGES_DAYS).
# 5) Cole as 6 envs abaixo no Dokploy (gateway → Environment) → Redeploy.
#    Confirmação no log de boot: `Bucket "wa-media" pronto`.
#
# Outros provedores (referência):
#   B2 : S3_ENDPOINT=https://s3.<region>.backblazeb2.com  S3_REGION=<region>  FORCE_PATH_STYLE=true
#   AWS: S3_ENDPOINT=https://s3.<region>.amazonaws.com    S3_REGION=<region>  FORCE_PATH_STYLE=false
#
# >>> COLE ESTAS 6 LINHAS NO DOKPLOY — só troque as 3 que começam com TROQUE_ <<<
# (o S3_ENDPOINT completo aparece PRONTO na tela final do token R2 — é só copiar de lá)
S3_ENDPOINT=https://TROQUE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=wa-media
S3_ACCESS_KEY=TROQUE_access_key_id_do_token_r2
S3_SECRET_KEY=TROQUE_secret_access_key_do_token_r2
S3_FORCE_PATH_STYLE=true     # true p/ R2/B2/MinIO · false p/ AWS S3
# (opcionais — já têm estes defaults no código; cole só se quiser mudar)
# MEDIA_URL_TTL=3600             # validade do link pré-assinado, em segundos
# MEDIA_MAX_BYTES=67108864       # 64 MB (limite por arquivo)

# -- Engine WWEBJS (whatsapp-web.js) — só se for usar esse motor ---------------
# Precisa do Chrome/Chromium instalado na imagem. Persista o WWEBJS_DATA_PATH
# (volume) para não re-parear a cada deploy.
# WWEBJS_CHROME_PATH=/usr/bin/google-chrome-stable
# WWEBJS_DATA_PATH=/data/wwebjs
# Versão do WhatsApp Web: default = versão FIXA validada p/ extração de leads COM telefone
# (builds mais novas escondem o número no rollout LID da Meta). 'auto' pega a mais nova
# (risco de LID-only); 'live' não fixa. A Meta expira versões em ~2 meses — revalidar antes de trocar.
# WWEBJS_WEB_VERSION=2.3000.1042271047-alpha

# -- Proxies -------------------------------------------------------------------
# Re-teste periódico do pool (revive DEAD que voltou, derruba quem morreu). 0 desliga.
# PROXY_RETEST_INTERVAL_MIN=30

# -- Guard-rail anti-ban (G1–G8) — onda M2 -------------------------------------
# HOJE (modo observação, default): o guard-rail MEDE reply-rate e registra o que FARIA,
# mas NÃO bloqueia nenhum envio. Nada a configurar — deixe TUDO deste bloco SEM definir.
#
# Liga/desliga do bloqueio (true/1/yes/on liga · false/0/no/off desliga · ausente = desligado):
#   • manter DESLIGADO (hoje).......: não defina nada (ou GUARDRAIL_ENFORCE=false)
#   • LIGAR (só no fim da janela M2): GUARDRAIL_ENFORCE=true + Redeploy
#   • DESLIGAR/rollback.............: GUARDRAIL_ENFORCE=false + Redeploy
# GUARDRAIL_ENFORCE=true
#
# Limiares (opcionais — os defaults abaixo já valem sem definir nada; e o
# PATCH /api/guardrail/config ajusta em runtime SEM redeploy, com prioridade sobre a env):
# GUARDRAIL_NMIN=20                  # amostra mínima de cold-sends maduros (>72h) p/ ter
#                                    # veredito; abaixo disso a sessão fica em "aquecimento"
# GUARDRAIL_THROTTLE_MULT=0.75       # reply-rate < mediana×0.75 → "throttled" (reduz ritmo)
# GUARDRAIL_QUARANTINE_MULT=0.6      # reply-rate < mediana×0.6 → "quarentena" (cold bloqueado,
#                                    # API responde HTTP 423 SESSION_QUARANTINED)
# GUARDRAIL_TARGET_REPLY_RATE=0.35   # baseline de fallback (35%) enquanto a frota tiver
#                                    # menos de 2 sessões com amostra confiável
# GUARDRAIL_COOLDOWN_HOURS=48        # tempo base de quarentena antes de reavaliar
# Guia completo da janela de observação e do flip: docs/how-to/observacao-guardrail-m2.md

# -- Segurança / observabilidade ------------------------------------------------
# Nível dos logs estruturados da app (JSON): fatal|error|warn|info|debug|trace|silent
# LOG_LEVEL=info
# Token do scrape Prometheus (GET /metrics?token=... ou Authorization: Bearer).
# SEM esta env o /metrics fica FECHADO (ele expõe dados operacionais).
# METRICS_TOKEN=TROQUE_token_forte
# Rate limit por IP/minuto (login tem teto próprio de 10/min). 0 desliga.
# RATE_LIMIT_MAX=600
# Fan-out de eventos entre réplicas via Redis pub/sub (SSE/webhooks enxergam todas). 'off' desliga.
# EVENT_FANOUT=on

# -- Retenção de dados (0 desliga a janela; varredura a cada RETENTION_SWEEP_HOURS)
# RETENTION_SWEEP_HOURS=6
# RETENTION_MESSAGE_RAW_DAYS=7     # zera o proto `raw` (pesado) das mensagens antigas
# RETENTION_MESSAGES_DAYS=90       # remove mensagens mais velhas que isso
# RETENTION_EVENTS_DAYS=30         # timeline de eventos de sessão
# RETENTION_AUDIT_DAYS=180         # audit log
