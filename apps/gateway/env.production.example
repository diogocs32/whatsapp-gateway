# =============================================================================
# EXEMPLO de configuração de PRODUÇÃO do gateway.
#
# Como usar:
#   - No Dokploy (recomendado): cole estas variáveis no painel do app em
#     "Environment" — NÃO suba arquivo .env com segredos para o servidor/git.
#   - Sem Dokploy: copie para `.env` no host e preencha os valores reais.
#
# Regras: troque TODO valor "TROQUE_*". Gere segredos fortes:
#     openssl rand -hex 32        (JWT_SECRET)
#     openssl rand -hex 24        (API_KEY)
# NUNCA versione o arquivo preenchido (já há .env* no .gitignore).
# =============================================================================

NODE_ENV=production
PORT=3000

# -- PostgreSQL ---------------------------------------------------------------
# Use o Postgres gerenciado do Dokploy (ou externo). Em Swarm/compose, o host é o
# NOME DO SERVIÇO (ex.: "postgres"). Em DB gerenciado/externo, exija SSL.
DATABASE_URL=postgresql://gateway:TROQUE_SENHA_DB@postgres:5432/gateway?schema=public&sslmode=require

# -- Redis (use senha em produção) --------------------------------------------
REDIS_URL=redis://default:TROQUE_SENHA_REDIS@redis:6379

# -- JWT do painel ------------------------------------------------------------
# Mínimo 16 chars; use 32+. Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_use_openssl_rand_hex_32
JWT_EXPIRES_IN=43200            # 12h em segundos

# -- API pública (header X-Api-Key) para integrações --------------------------
# Mínimo 8 chars. Gere com: openssl rand -hex 24
API_KEY=TROQUE_chave_api_forte

# -- Admin inicial do painel (criado no 1º boot, se não houver usuários) -------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=TROQUE_senha_admin_forte    # mínimo 6; use 16+

# -- CORS: domínio(s) do dashboard em produção (https), separados por vírgula --
# Inclua todos os domínios que acessam a API pelo navegador (dashboard, landing).
CORS_ORIGIN=https://app.conexozenvo.com

# -- Nível de log da engine: fatal|error|warn|info|debug|trace|silent ---------
WA_LOG_LEVEL=warn

# -- Proxies (F3) — opcional --------------------------------------------------
# WEBSHARE_API_KEY=seu-token-webshare      # habilita o sync automático do pool
PROXY_TEST_ECHO_URL=https://api.ipify.org?format=json

# -- Storage de mídia (S3-compatível) -----------------------------------------
# Em produção use Cloudflare R2 ou Backblaze B2 (compatíveis com S3). Exemplos:
#   R2 : S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto   FORCE_PATH_STYLE=true
#   B2 : S3_ENDPOINT=https://s3.<region>.backblazeb2.com           S3_REGION=<region> FORCE_PATH_STYLE=true
#   AWS: S3_ENDPOINT=https://s3.<region>.amazonaws.com             S3_REGION=<region> FORCE_PATH_STYLE=false
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=wa-media
S3_ACCESS_KEY=TROQUE_access_key
S3_SECRET_KEY=TROQUE_secret_key
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL=3600             # validade do link pré-assinado, em segundos
MEDIA_MAX_BYTES=67108864      # 64 MB (limite por arquivo)

# -- Engine WWEBJS (whatsapp-web.js) — só se for usar esse motor ---------------
# Precisa do Chrome/Chromium instalado na imagem. Persista o WWEBJS_DATA_PATH
# (volume) para não re-parear a cada deploy.
# WWEBJS_CHROME_PATH=/usr/bin/google-chrome-stable
# WWEBJS_DATA_PATH=/data/wwebjs
